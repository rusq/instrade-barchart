{
  "manifest_version": 3,
  "name": "Barchart Insider Trades Exporter",
  "version": "0.1.1",
  "description": "Export insider trades from the current Barchart page as NDJSON.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Export Barchart insider trades"
  }
}
